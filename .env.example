# ============================================================
# GoForum 环境配置（Laravel 风格 .env）
#
# 使用方式：
#   1. 复制本文件为 .env           cp .env.example .env
#   2. 按需修改下面的值
#   3. 重启程序生效
#
# 优先级（后者覆盖前者）：
#   内置默认值 → configs/goforum.yaml → .env → 真实环境变量
#
# 语法：KEY=VALUE；# 开头为注释；值含空格时用双引号包裹；
#       支持 ${OTHER_KEY} 引用本文件前面的变量。
#
# 数据库切换：下面三个区块各自带 DB_CONNECTION。
#   把要用的那块取消注释、其余整块注释掉，重启即可。
#   同一时间只保留一个区块生效。
# ============================================================

# ---------- 应用 ----------
# production | development（development 会开启模板热加载并回显调试信息）
APP_ENV=production
# 站点对外访问地址，影响邮件链接、OAuth 回调与 canonical
APP_URL=https://forum.example.com
# 会话与签名密钥，生成方式：
#   openssl rand -base64 32
APP_KEY=

# 监听地址
HTTP_ADDR=:8080
# 单次请求体上限（MB），影响附件上传
HTTP_MAX_BODY_MB=32
# 反向代理白名单，逗号分隔；留空表示不信任任何代理
HTTP_TRUSTED_PROXIES=
HTTP_METRICS_ENABLED=false
HTTP_METRICS_TOKEN=

# ============================================================
# 数据库（三选一，当前生效：SQLite）
# ============================================================

# ---------- 1. SQLite（当前使用）----------
# 零依赖、单文件，适合个人站与小型社区
DB_CONNECTION=sqlite
DB_DATABASE=./data/goforum.db

# ---------- 2. PostgreSQL ----------
# 推荐用于生产：并发写入与全文检索都更稳
# 取消下面整块注释，并注释掉上面的 SQLite 区块
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=goforum
# DB_USERNAME=goforum
# DB_PASSWORD=change-me
# DB_SSLMODE=disable

# ---------- 3. MySQL / MariaDB ----------
# 需 MySQL 8.0+ 或 MariaDB 10.5+
# 取消下面整块注释，并注释掉上面的 SQLite 区块
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=goforum
# DB_USERNAME=goforum
# DB_PASSWORD=change-me

# ---------- 连接池（三种数据库通用）----------
DB_MAX_OPEN=25
DB_MAX_IDLE=10
DB_MAX_LIFETIME=30m

# 高级：完整连接串，填写后优先于上面的分项配置
# DB_DSN=

# ============================================================
# 缓存
# ============================================================
# memory（单进程，默认）| redis（多实例共享，限流/计数/任务锁跨实例生效）
CACHE_STORE=memory
# 启用 redis 时填写连接串，例如 redis://:password@127.0.0.1:6379/0
REDIS_URL=
# 键前缀，多个站点共用一个 Redis 时用于隔离
CACHE_PREFIX=
CACHE_TTL=5m

# ============================================================
# 存储
# ============================================================
# local（目前仅支持本地存储）
FILESYSTEM_DISK=local
STORAGE_PATH=./data/uploads
STORAGE_URL=/uploads

# ============================================================
# 邮件
# ============================================================
# log（写入日志，适合开发）| smtp
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# ============================================================
# 日志
# ============================================================
# debug | info | warn | error
LOG_LEVEL=info
# json | text
LOG_CHANNEL=json

# ============================================================
# 会话
# ============================================================
SESSION_COOKIE=gf_session
# 支持 720h / 30m 写法；纯数字按秒处理（如 1209600 = 14 天）
SESSION_LIFETIME=720h

# ============================================================
# 后台任务
# ============================================================
WORKER_ENABLED=true

# ============================================================
# 备份加密
# ============================================================
# 备份文件包含密码哈希、第三方密钥与私信内容，默认强制加密。
# 生成密钥：goforum backup -gen-key（或 openssl rand -base64 32）
# 密钥必须与备份分开保存；丢失密钥会导致备份无法恢复。
# GF_BACKUP_KEY=
#
# 仅在明确接受风险时才允许写明文备份（命令加 -plaintext 也等同于允许）。
